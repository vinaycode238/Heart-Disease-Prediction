# calculating acutual number of outliers

for col in num_feature:
    Q1 =df[col].quantile(0.25)
    Q3 =df[col].quantile(0.75)

    IQR = Q3-Q1
    upper= Q3 +1.5*IQR
    lower= Q1 -1.5*IQR

    find_outlier =df[(df[col] > upper) | (df[col]<lower)]
    print(f"{col} : {len(find_outlier)} outliers")


